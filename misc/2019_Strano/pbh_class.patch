+/**
+ * Effective decay rate of the dcdm component at cosmological time t [Mpc].
+ * Default CLASS: constant Gamma_dcdm (exponential decay).
+ * dcdm_pbh_law: a monochromatic population of black holes each obeying dM/dt = -k/M
+ * (emission ~ E_P/(2 r_s) per Planck time), so M(t) = M0 sqrt(1 - t/t_evap) and the
+ * comoving density a^3 rho_dcdm falls as sqrt(1 - t/t_evap): Gamma(t) = 1/(2 (t_evap - t)).
+ * Past t_evap (1 - pbh_cutoff) the decay is switched off; a remnant fraction sqrt(pbh_cutoff) stays as cold matter.
+ */
+double background_gamma_dcdm(struct background *pba, double t) {
+  double x;
+  if (pba->dcdm_pbh_law == _FALSE_)
+    return pba->Gamma_dcdm;
+  x = 1. - t / pba->t_evap_dcdm;          /* remaining fraction of the evaporation time */
+  if (x <= 0.)
+    return 0.;
+  return 0.5 / (pba->t_evap_dcdm * MAX(x, pba->pbh_cutoff));
+}
+
+/** Surviving mass fraction M(t)/M0 = sqrt(1 - t/t_evap) of each hole (1 for exponential dcdm, handled by the ODE). */
+double background_pbh_survival(struct background *pba, double t) {
+  double x;
+  if (pba->dcdm_pbh_law == _FALSE_)
+    return 1.;
+  x = 1. - t / pba->t_evap_dcdm;
+  return (x > 0.) ? sqrt(x) : 0.;
+}
+
 int background_functions(
                          struct background * pba,
                          double a,
