 #include "perturbations.h"
 #include "parallel.h"
 
+/* ===== Created neutrinos + ghost coexistence gas (Strano model) =====
+   By (Anthropic) Claude and Dan Strano.
+
+   Background (exact Lambda): ghost gas rho_g = -G, p_g = rho_g/3, held at T_c; it feeds Q = 4 H G (global rate)
+   into pair creation of the ncdm mass eigenstates, in number ratio m_i^2, thermal (Fermi-Dirac in E) at T_c in the
+   ghost frame. Steady state: f0_i(q,tau) = C_i Phi_i(q/a), Phi(x) = int_x^inf phi(y) dy/y, phi = 1/(e^{E/T_c}+1).
+   Then rho_i + p_i = (4G/3) s_i (energy shares s_i) and sum(rho) = rho_Lambda, sum(rho+p) = 0 exactly.
+
+   Perturbations (synchronous gauge), Psi_l(q) per created species, with f = f0 (1+Psi):
+     Psi_l' = [standard ncdm free streaming, dlnf0/dlnq = -phi/Phi] + Gamma_q (B_l - Psi_l),  Gamma_q = aH phi/Phi,
+     B_0 = 0 (global rate: no density perturbation of the source in synchronous slicing),
+     B_1 = [(1-phi) - 1/E] x theta_g/(3k)  (covariant source Q u_ghost: momentum injection a Q theta_g exactly),
+     B_l>=2 = 0.
+   Ghost fluid (w = c_s^2 = 1/3, no shear, delta Q = 0):
+     delta_g' = -4/3 (theta_g + h'/2) - 4 aH delta_g,   theta_g' = -aH theta_g + k^2 delta_g/4. */
+
+static double crt_phi(double E) { return 1./(exp(E)+1.); }
+static int crt_dbg = -1;   /* debug switches via CRT_DEBUG: 1 = no creation relaxation, 2 = no ghost dipole, 4 = no ghost in Einstein eqs */
+static int crt_debug(void) { if (crt_dbg < 0) { char * e = getenv("CRT_DEBUG"); crt_dbg = e ? atoi(e) : 0; } return crt_dbg; }
+
+static double crt_lnPhi(struct perturbations * ppt, int ic, double x) {
+  double * t = ppt->crt_lnPhi_tab + ic*ppt->crt_ntab;
+  double lx = log(x), u;
+  int j;
+  if (lx <= ppt->crt_lnx_min) {
+    /* Phi(x) ~ Phi(x_min) + phi(mu) ln(x_min/x) */
+    return log(exp(t[0]) + crt_phi(ppt->crt_mu[ic])*(ppt->crt_lnx_min-lx));
+  }
+  u = (lx - ppt->crt_lnx_min)/ppt->crt_dlnx;
+  j = (int)u;
+  if (j >= ppt->crt_ntab-1) return -1.e30;
+  u -= j;
+  return (1.-u)*t[j] + u*t[j+1];
+}
+
+/* r = phi/Phi = -dln f0/dln q (creation rate per particle in units of aH). Smoothly capped at r_cap: empty
+   high-momentum bins then relax quickly (stiffly) to their quasi-static values; D and Gamma share the same r, so the
+   quasi-static limit Psi_0 -> -h'/(6 aH) is unaffected by the cap. */
+static double crt_ratio(struct perturbations * ppt, int ic, double x, double E) {
+  double r, r_cap = 500.;
+  if (E < 60.) r = crt_phi(E)/exp(crt_lnPhi(ppt,ic,x));
+  else r = x*x/E + 1.;
+  return r_cap*tanh(r/r_cap);
+}
+
+/* closure denominator -1 + (4/3) sum_i s_i rho_i/(rho_i+p_i) at temperature Tc (same quadrature as the setup);
+   |rho_ghost| = rho_Lambda / denominator. Returns <= 0 when the created gas is too hot to close. */
+static double crt_closure_denom(double Tc_eV, int N, double * m_eV, double xtop) {
+  int ic, j, ntab = 6000;
+  double lnx_min = log(1.e-14), lnx_max = log(xtop), dl = (lnx_max - lnx_min)/(ntab-1);
+  double sh[3], R[3], sumsh = 0., sumsR = 0.;
+  for (ic=0; ic<N; ic++) {
+    double mu = m_eV[ic]/Tc_eV, Phi = 0., In = 0., Ie = 0., Je = 0., Jp = 0., x, E, ph, phprev = 0.;
+    for (j=ntab-1; j>=0; j--) {          /* integrate Phi downward, accumulate moments */
+      double w = (j==0 || j==ntab-1) ? 0.5 : 1.;
+      x = exp(lnx_min + j*dl); E = sqrt(x*x+mu*mu); ph = 1./(exp(E)+1.);
+      if (j < ntab-1) Phi += 0.5*(ph+phprev)*dl; else Phi = ph/E;
+      phprev = ph;
+      In += w*x*x*x*ph; Ie += w*x*x*x*E*ph; Je += w*x*x*x*E*Phi; Jp += w*x*x*x*x*x/(3.*E)*Phi;
+    }
+    sh[ic] = mu*mu*Ie/In; sumsh += sh[ic]; R[ic] = Je/(Je+Jp);
+  }
+  for (ic=0; ic<N; ic++) sumsR += sh[ic]/sumsh*R[ic];
+  return -1. + 4./3.*sumsR;
+}
+
+int perturbations_crt_setup(struct precision * ppr, struct background * pba, struct perturbations * ppt) {
+
+  int n, ic, j, iq, ntab = 6000;
+  double Tc_eV, x, E, ph, lnx_max, rhoL, denom, a_on, q_lo, q_hi, kB = 8.617333262e-5;
+  double In[3], Ie[3], Je[3], Jp[3], nu[3], share[3], R[3], sumnuE = 0., sumnu = 0., sumsR = 0.;
+  double * tab;
+
+  class_test(ppt->gauge != synchronous, ppt->error_message,
+             "created_neutrinos is implemented in synchronous gauge only");
+  class_test(pba->has_ncdm == _FALSE_, ppt->error_message,
+             "created_neutrinos needs the neutrino mass eigenstates as ncdm species (N_ncdm, m_ncdm)");
+  class_test(pba->Omega0_lambda <= 0., ppt->error_message,
+             "created_neutrinos: the ghost + created gas reproduce Lambda; set Omega_Lambda > 0 (not fluid)");
+
+  ppt->crt_a_on = 1./(1.+ppt->crt_z_on);
+
+  /* optional: T_c from first principles. The ghost gas is a blackbody at T_c with g massless bosonic degrees of
+     freedom, |rho_ghost| = g (pi^2/30) T_c^4 = (g/2) rho_gamma (T_c/T_cmb)^4, and it must equal the value closure
+     (exact Lambda) demands, rho_Lambda / denom(T_c). Take the lowest root. */
+  if (ppt->crt_ghost_dof > 0.) {
+    double m_sel[3], mmax = 0., T1, T2, f1, f2, Tm, fm, den;
+    int Nsel = 0, it;
+    for (n=0; n<pba->N_ncdm; n++) mmax = MAX(mmax, pba->m_ncdm_in_eV[n]);
+    for (n=0; n<pba->N_ncdm && Nsel<3; n++)
+      if (pba->m_ncdm_in_eV[n]*pba->m_ncdm_in_eV[n] > 1.e-4*mmax*mmax) m_sel[Nsel++] = pba->m_ncdm_in_eV[n];
+    rhoL = pba->Omega0_lambda*pba->H0*pba->H0;
+#define CRT_F(TK, out) { den = crt_closure_denom((TK)*kB, Nsel, m_sel, ppt->crt_x_max + 50.); \
+      out = 0.5*ppt->crt_ghost_dof*pba->Omega0_g*pba->H0*pba->H0*pow((TK)/pba->T_cmb,4) - ((den > 0.) ? rhoL/den : 1.e300); }
+    T1 = 1.; CRT_F(T1, f1);
+    for (T2 = T1*1.02; T2 < 1.e4; T2 *= 1.02) { CRT_F(T2, f2); if (f1 < 0. && f2 >= 0.) break; T1 = T2; f1 = f2; }
+    class_test(T2 >= 1.e4, ppt->error_message, "created_ghost_dof: no self-consistent T_c below 1e4 K");
+    for (it=0; it<60; it++) { Tm = 0.5*(T1+T2); CRT_F(Tm, fm); if (fm < 0.) T1 = Tm; else T2 = Tm; }
+#undef CRT_F
+    ppt->crt_Tc_K = 0.5*(T1+T2);
+  }
+
+  Tc_eV = ppt->crt_Tc_K*kB;
+  ppt->crt_N = 0;
+  {
+    double mmax = 0.;
+    for (n=0; n<pba->N_ncdm; n++) mmax = MAX(mmax, pba->m_ncdm_in_eV[n]);
+    for (n=0; n<pba->N_ncdm && ppt->crt_N<3; n++) {
+    /* species whose creation share (~m^2) is below 1e-4 of the heaviest are dropped */
+    if (pba->m_ncdm_in_eV[n]*pba->m_ncdm_in_eV[n] > 1.e-4*mmax*mmax) {
+      ppt->crt_mu[ppt->crt_N] = pba->m_ncdm_in_eV[n]/Tc_eV;
+      class_test(sqrt(ppt->crt_mu[ppt->crt_N]*ppt->crt_mu[ppt->crt_N]) > ppt->crt_x_max-2., ppt->error_message,
+                 "created_neutrinos: m/T_c = %g too large for created_E_max = %g", ppt->crt_mu[ppt->crt_N], ppt->crt_x_max);
+      ppt->crt_N++;
+    }
+    }
+  }
+  class_test(ppt->crt_N == 0, ppt->error_message, "created_neutrinos: no massive ncdm species");
+
+  /* tables of ln Phi_i on a log grid in x = p/T_c */
+  ppt->crt_ntab = ntab;
+  ppt->crt_lnx_min = log(1.e-14);
+  lnx_max = log(ppt->crt_x_max + 50.);
+  ppt->crt_dlnx = (lnx_max - ppt->crt_lnx_min)/(ntab-1);
+  class_alloc(ppt->crt_lnPhi_tab, ppt->crt_N*ntab*sizeof(double), ppt->error_message);
+  class_alloc(tab, ntab*sizeof(double), ppt->error_message);
+
+  for (ic=0; ic<ppt->crt_N; ic++) {
+    double mu = ppt->crt_mu[ic], Ej, Ej1;
+    x = exp(lnx_max); E = sqrt(x*x+mu*mu);
+    tab[ntab-1] = crt_phi(E)/E;   /* tail estimate, negligible */
+    for (j=ntab-2; j>=0; j--) {
+      double x0 = exp(ppt->crt_lnx_min + j*ppt->crt_dlnx), x1 = exp(ppt->crt_lnx_min + (j+1)*ppt->crt_dlnx);
+      Ej = sqrt(x0*x0+mu*mu); Ej1 = sqrt(x1*x1+mu*mu);
+      tab[j] = tab[j+1] + 0.5*(crt_phi(Ej)+crt_phi(Ej1))*ppt->crt_dlnx;
+    }
+    In[ic] = Ie[ic] = Je[ic] = Jp[ic] = 0.;
+    for (j=0; j<ntab; j++) {
+      double w = (j==0 || j==ntab-1) ? 0.5 : 1.;
+      x = exp(ppt->crt_lnx_min + j*ppt->crt_dlnx); E = sqrt(x*x+mu*mu); ph = crt_phi(E);
+      ppt->crt_lnPhi_tab[ic*ntab+j] = log(tab[j]);
+      In[ic] += w*x*x*x*ph;            Ie[ic] += w*x*x*x*E*ph;
+      Je[ic] += w*x*x*x*E*tab[j];      Jp[ic] += w*x*x*x*x*x/(3.*E)*tab[j];
+    }
+    nu[ic] = mu*mu;                     /* creation rate per species ~ g_i^2 ~ m_i^2 */
+    sumnu += nu[ic];
+    sumnuE += nu[ic]*Ie[ic]/In[ic];
+  }
+  free(tab);
+
+  rhoL = pba->Omega0_lambda*pba->H0*pba->H0;
+  for (ic=0; ic<ppt->crt_N; ic++) {
+    share[ic] = nu[ic]*(Ie[ic]/In[ic])/sumnuE;   /* energy share of Q */
+    R[ic] = Je[ic]/(Je[ic]+Jp[ic]);              /* rho/(rho+p) of the steady spectrum */
+    sumsR += share[ic]*R[ic];
+  }
+  denom = -1. + 4./3.*sumsR;
+  class_test(denom <= 0., ppt->error_message,
+             "created_neutrinos: created gas too hot (sum s_i rho_i/(rho_i+p_i) <= 3/4); no ghost density reproduces Lambda");
+  ppt->crt_G = rhoL/denom;
+  for (ic=0; ic<ppt->crt_N; ic++) {
+    ppt->crt_rho_plus_p[ic] = 4./3.*ppt->crt_G*share[ic];
+    ppt->crt_rho[ic] = ppt->crt_rho_plus_p[ic]*R[ic];
+    ppt->crt_Je[ic] = Je[ic]*ppt->crt_dlnx;           /* exact int x^3 E Phi dlnx */
+    ppt->crt_Jrp[ic] = (Je[ic]+Jp[ic])*ppt->crt_dlnx; /* exact int x^3 (E + x^2/3E) Phi dlnx */
+  }
+
+  /* comoving momentum grid (units T_c, a_0 = 1) */
+  a_on = ppt->crt_a_on;
+  q_lo = 1.e-2*a_on;   /* x < 0.01 carries a negligible share of rho at all times */
+  q_hi = ppt->crt_x_max + 2.;
+  ppt->crt_nq = (int)ceil(log10(q_hi/q_lo)*ppt->crt_q_per_decade) + 1;
+  class_alloc(ppt->crt_q, ppt->crt_nq*sizeof(double), ppt->error_message);
+  for (iq=0; iq<ppt->crt_nq; iq++)
+    ppt->crt_q[iq] = q_lo*pow(q_hi/q_lo, (double)iq/(ppt->crt_nq-1));
+
+  if (ppt->perturbations_verbose > 0) {
+    if (ppt->crt_ghost_dof > 0.)
+      printf(" -> created neutrinos: T_c solved self-consistently for g = %g ghost dof: T_c = %.4f K (ghost blackbody %.4f rho_L)\n",
+             ppt->crt_ghost_dof, ppt->crt_Tc_K,
+             0.5*ppt->crt_ghost_dof*pba->Omega0_g*pow(ppt->crt_Tc_K/pba->T_cmb,4)/pba->Omega0_lambda);
+    printf(" -> created neutrinos: T_c = %g K, %d species, |rho_ghost| = %.4f rho_Lambda, %d q-bins x %d multipoles, on at z = %g\n",
+           ppt->crt_Tc_K, ppt->crt_N, ppt->crt_G/rhoL, ppt->crt_nq, ppt->crt_lmax+1, ppt->crt_z_on);
+    for (ic=0; ic<ppt->crt_N; ic++) {
+      /* checks: steady-state identity 3 (Je+Jp) = Ie, and momentum injection on the q-grid (should be 3) */
+      double Nrp = 0., M = 0., mu = ppt->crt_mu[ic];
+      for (iq=0; iq<ppt->crt_nq; iq++) {
+        x = ppt->crt_q[iq]; E = sqrt(x*x+mu*mu); ph = crt_phi(E);
+        Nrp += x*x*x*(E + x*x/(3.*E))*exp(crt_lnPhi(ppt,ic,x));
+        M += x*x*x*x*x*ph*((1.-ph) - 1./E)/3.;
+      }
+      printf("    species %d: m/T_c = %.3f, energy share %.4f, rho = %.4f rho_L, w = %.4f; identity 3(Je+Jp)/Ie = %.6f; grid momentum check %.5f (3)\n",
+             ic, mu, share[ic], ppt->crt_rho[ic]/rhoL, 1./R[ic]-1., 3.*(Je[ic]+Jp[ic])/Ie[ic], M/Nrp);
+    }
+  }
+
+  return _SUCCESS_;
+}
